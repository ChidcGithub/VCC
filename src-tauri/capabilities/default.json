{
  "$schema": "https://schema.tauri.app/capabilities/default",
  "identifier": "default",
  "windows": [
    "main",
    "floating",
    "overlay",
    "overlay-*",
    "dialog"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-start-dragging"
  ]
}
